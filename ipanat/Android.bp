// SPDX-License-Identifier: GPL-2.0-only
//
// Source definitions for the legacy IPACM consumers.  Cupid does not add
// IPACM to its product, but Soong still parses the Qualcomm Android.bp files
// when generating the global module graph.

cc_library_shared {
    name: "libipanat",
    vendor: true,
    srcs: [
        "src/ipa_nat_drv.c",
        "src/ipa_nat_drvi.c",
        "src/ipa_nat_utils.c",
        "src/ipa_table.c",
        "src/ipa_mem_descriptor.c",
        "src/ipa_ipv6ct.c",
        "src/ipa_nat_statemach.c",
        "src/ipa_nat_map.cpp",
    ],
    local_include_dirs: ["inc"],
    cflags: [
        "-Wall",
        "-Wundef",
        "-Wstrict-prototypes",
        "-Wno-trigraphs",
        "-DUSE_GLIB",
    ],
    export_include_dirs: ["inc"],
}
